{
  "name": "ezplate",
  "version": "1.0.0",
  "description": "EzPlate — plate/menu costing PWA. Tagline: Plate costing made easy.",
  "private": true,
  "scripts": {
    "test": "node --test --test-concurrency=2 tests/*.test.js",
    "preflight": "node tests/preflight-processes.js",
    "mutate": "node tests/preflight-processes.js --reap && node tests/mutation/run.js",
    "mutate:changed": "node tests/preflight-processes.js --reap && node tests/mutation/run.js --changed",
    "smoke": "node tests/smoke.js",
    "serve": "npx --yes serve@14 . -l 5173",
    "shots": "playwright test tests/visual"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
